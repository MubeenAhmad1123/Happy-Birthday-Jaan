# Copy to .env.local and fill in real values
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# 32+ random bytes, base64 encoded
SESSION_SECRET=replace-with-32-plus-random-bytes-base64

# Separate admin password
ADMIN_PASSWORD=replace-with-strong-admin-password

# Unlock date/time in ISO 8601 (Pakistan = UTC+5)
UNLOCK_AT=2026-11-05T00:00:00+05:00

# The 24-char random slug for the site path (e.g. /g/abc123...)
SITE_SLUG=replace-with-24-char-random-slug

# Set to "true" to bypass the unlock date check (admin testing)
UNLOCK_NOW=false

